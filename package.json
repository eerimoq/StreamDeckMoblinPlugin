  "scripts": {
    "build": "rollup -c",
    "pack": "rm -f com.eerimoq.moblin.streamDeckPlugin && streamdeck pack com.eerimoq.moblin.sdPlugin",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.eerimoq.moblin\"",
    "format": "oxfmt",
    "lint": "oxlint"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.3",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "~20.15.0",
    "@types/ws": "^8.18.1",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  }
}
